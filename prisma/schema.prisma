datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ContentEntryStatus {
  DRAFT
  PUBLISHED
}

enum TemplateType {
  EMAIL
  HTML_PAGE
  JSON
}

enum ContentTypeKind {
  COLLECTION
  SINGLE
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  googleId  String   @unique @map("google_id")
  name      String
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships    OrgMember[]
  contentEntries ContentEntry[]
  apiKeys        ApiKey[]
  auditLogs      AuditLog[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members      OrgMember[]
  roles        Role[]
  contentTypes ContentType[]
  components   Component[]
  entries      ContentEntry[]
  templates    Template[]
  apiKeys      ApiKey[]
  auditLogs    AuditLog[]

  @@map("organizations")
}

model OrgMember {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  orgId    String   @map("org_id")
  roleId   String   @map("role_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, orgId])
  @@map("org_members")
}

model Role {
  id          String   @id @default(uuid())
  orgId       String?  @map("org_id") // Null for global/system roles
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  org             Organization?    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members         OrgMember[]
  rolePermissions RolePermission[]

  @@unique([orgId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  action      String   @unique // e.g., 'content.create'
  description String
  group       String   // e.g., 'Content', 'Schema'

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model ContentType {
  id          String          @id @default(uuid())
  orgId       String          @map("org_id")
  name        String
  slug        String
  description String?
  kind        ContentTypeKind @default(COLLECTION)
  schema      Json            // JSONB schema definition
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  org       Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entries   ContentEntry[]
  templates Template[]

  @@unique([orgId, slug])
  @@map("content_types")
}

model Component {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String
  slug      String
  category  String   @default("default")
  schema    Json     // JSONB field definition
  createdAt DateTime @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, slug])
  @@map("components")
}

model ContentEntry {
  id            String             @id @default(uuid())
  contentTypeId String             @map("content_type_id")
  orgId         String             @map("org_id")
  createdById   String             @map("created_by")
  status        ContentEntryStatus @default(DRAFT)
  data          Json               // Draft/working data
  publishedData Json?              @map("published_data") // Immutable published snapshot
  publishedAt   DateTime?          @map("published_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  contentType ContentType  @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("content_entries")
}

model Template {
  id                String       @id @default(uuid())
  orgId             String       @map("org_id")
  contentTypeId     String?      @map("content_type_id")
  name              String
  type              TemplateType @default(EMAIL)
  bodyDraft         String       @map("body_draft") @db.Text
  bodyPublished     String?      @map("body_published") @db.Text
  subjectDraft      String?      @map("subject_draft")
  subjectPublished  String?      @map("subject_published")
  status            String       @default("DRAFT")
  publishedAt       DateTime?    @map("published_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contentType ContentType? @relation(fields: [contentTypeId], references: [id], onDelete: SetNull)

  @@map("templates")
}

model ApiKey {
  id         String    @id @default(uuid())
  orgId      String    @map("org_id")
  createdById String   @map("created_by")
  name       String
  keyPrefix  String    @map("key_prefix") // First 12 chars e.g. "sk_live_xxxx"
  keyHash    String    @unique @map("key_hash") // SHA-256 hash
  isActive   Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model AuditLog {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  userId       String?  @map("user_id")
  action       String   // e.g. 'CREATE', 'UPDATE', 'DELETE', 'PUBLISH'
  resourceType String   @map("resource_type") // 'content_type', 'content_entry', 'template', etc.
  resourceId   String?  @map("resource_id")
  details      Json?
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
