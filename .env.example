# ==============================================================================
# CMS Environment Configuration
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development
PORT=5000

# Client App URL (for CORS & OAuth redirects)
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/cms_db?schema=public"

# Redis Cache (Optional for dev, required for production cache)
REDIS_URL="redis://localhost:6379"

# Authentication (JWT) - Must be >= 32 random characters
JWT_SECRET="generate-a-cryptographically-strong-random-secret-min-32-chars"
JWT_EXPIRATION="7d"

# Google OAuth Credentials (Obtain from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

# Access Gate (Comma-separated allowed emails. Leave empty to allow all Google logins)
ALLOWED_EMAILS=""

# API Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Single-Port Monolith Production Static Assets (Optional; defaults to /app/apps/web/dist in Docker)
# STATIC_PATH="/app/apps/web/dist"

# ==============================================================================
# Email Scheduler & SMTP Configuration (BullMQ Queue Workers)
# ==============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-smtp-email@gmail.com"
SMTP_PASS="your-smtp-app-password"
SMTP_SECURE=false
SMTP_FROM="CMS Notifications <noreply@cms.local>"

# Default Recipient for Schedulers (receives copy on dispatch & default if 'to' omitted)
DEFAULT_EMAIL_RECIPIENT="admin@yourdomain.com"

