{
  "name": "cms-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "nx run-many --target=dev --parallel=true",
    "dev:api": "nx dev api",
    "dev:web": "nx dev web",
    "build": "nx run-many --target=build --parallel=true",
    "build:api": "nx build api",
    "build:web": "nx build web",
    "lint": "nx run-many --target=lint",
    "test": "nx run-many --target=test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --project tsconfig.base.json --transpile-only prisma/seed.ts"
  },
  "devDependencies": {
    "nx": "^20.4.0",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "picomatch": "^2.3.1",
    "tmp": "^0.2.7",
    "cross-spawn": "^7.0.6",
    "glob": "^10.5.0",
    "dompurify": "^3.4.15",
    "qs": "^6.16.0",
    "body-parser": "^1.20.8"
  }
}
