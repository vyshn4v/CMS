{
  "openapi": "3.0.3",
  "info": {
    "title": "Headless CMS API",
    "version": "0.1.0",
    "description": "Production REST API for the Headless Content Management & Universal Template Render Engine."
  },
  "servers": [
    {
      "url": "http://localhost:5000/api/v1",
      "description": "Local Development Server"
    },
    {
      "url": "https://cms.example.com/api/v1",
      "description": "Production Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "jwt",
        "description": "HttpOnly session cookie created on Google OAuth login."
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "User JWT authorization header."
      },
      "apiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Organization Delivery API Key (sk_live_...)."
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "integer", "example": 200 },
          "data": { "type": "object" }
        },
        "required": ["status", "data"]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "statusCode": { "type": "integer", "example": 403 },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "FORBIDDEN" },
              "message": { "type": "string", "example": "Missing required permission" }
            }
          },
          "timestamp": { "type": "string", "format": "date-time" },
          "path": { "type": "string" }
        }
      },
      "RenderRequest": {
        "type": "object",
        "properties": {
          "schemaId": { "type": "string", "format": "uuid", "description": "Target Content Type UUID" },
          "templateId": { "type": "string", "format": "uuid", "description": "Optional direct Template UUID" },
          "contentId": { "type": "string", "format": "uuid", "description": "Optional published entry ID to populate content" },
          "data": { "type": "object", "description": "Dynamic runtime variables" },
          "variables": { "type": "object", "description": "Optional auxiliary template context" }
        }
      }
    }
  },
  "paths": {
    "/auth/me": {
      "get": {
        "summary": "Get authenticated user profile and permissions",
        "tags": ["Auth"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": {
          "200": { "description": "User profile with organization memberships and permissions" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Log out and clear session cookie",
        "tags": ["Auth"],
        "responses": {
          "200": { "description": "Logged out successfully" }
        }
      }
    },
    "/orgs": {
      "get": {
        "summary": "List user organizations",
        "tags": ["Organizations"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of organizations" }
        }
      },
      "post": {
        "summary": "Create new organization",
        "tags": ["Organizations"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "example": "Marketing HQ" },
                  "slug": { "type": "string", "example": "marketing-hq" }
                },
                "required": ["name"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Organization created" }
        }
      }
    },
    "/orgs/{orgId}/schemas": {
      "get": {
        "summary": "List Content Types (schemas)",
        "tags": ["Schemas"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "orgId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of content schemas" }
        }
      },
      "post": {
        "summary": "Create Content Type",
        "tags": ["Schemas"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "orgId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "slug": { "type": "string" },
                  "kind": { "type": "string", "enum": ["COLLECTION", "SINGLE"] },
                  "schema": { "type": "object" }
                },
                "required": ["name"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Schema created" }
        }
      }
    },
    "/orgs/{orgId}/components": {
      "get": {
        "summary": "List reusable components",
        "tags": ["Components"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "orgId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of components" }
        }
      }
    },
    "/orgs/{orgId}/content/{slug}": {
      "get": {
        "summary": "List content entries",
        "tags": ["Content Entries"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "orgId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["DRAFT", "PUBLISHED"] } }
        ],
        "responses": {
          "200": { "description": "Paginated content entries" }
        }
      },
      "post": {
        "summary": "Create content entry",
        "tags": ["Content Entries"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "orgId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": { "type": "object" },
                  "publish": { "type": "boolean", "default": false }
                },
                "required": ["data"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Entry created" }
        }
      }
    },
    "/orgs/{orgId}/templates": {
      "get": {
        "summary": "List templates",
        "tags": ["Templates"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "orgId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "contentTypeId", "in": "query", "schema": { "type": "string" } },
          { "name": "type", "in": "query", "schema": { "type": "string", "enum": ["EMAIL", "HTML_PAGE", "JSON"] } }
        ],
        "responses": {
          "200": { "description": "List of templates" }
        }
      }
    },
    "/render": {
      "post": {
        "summary": "Public Render API",
        "description": "Render a published template using organization API Key authentication.",
        "tags": ["Render API"],
        "security": [{ "apiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RenderRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Rendered HTML/JSON output" },
          "401": { "description": "Invalid API Key" },
          "404": { "description": "Template or model not found" }
        }
      }
    },
    "/orgs/{orgId}/api-keys": {
      "get": {
        "summary": "List API keys",
        "tags": ["API Keys"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "orgId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of API keys" }
        }
      },
      "post": {
        "summary": "Generate new API key",
        "tags": ["API Keys"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "orgId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "example": "Backend Service Key" }
                },
                "required": ["name"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "API key generated with plaintext key value" }
        }
      }
    },
    "/orgs/{orgId}/audit-logs": {
      "get": {
        "summary": "List audit logs",
        "tags": ["Audit Logs"],
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "orgId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "action", "in": "query", "schema": { "type": "string" } },
          { "name": "resourceType", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Audit trail entries" }
        }
      }
    }
  }
}
